generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Match {
  id             String    @id @default(uuid())
  hkjcMatchId    String?   @unique
  homeTeam       String
  awayTeam       String
  tournamentName String?
  startTime      DateTime
  status         String    @default("scheduled")
  result         String?
  oddsData       Json?
  oddsUpdatedAt  DateTime?
  createdAt      DateTime  @default(now())
}
