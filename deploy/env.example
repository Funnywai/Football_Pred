# Copy to the repo root as `.env` on the server:  cp deploy/env.example .env
# docker compose reads this file for both container env and ${...} interpolation.
# This file is an EXAMPLE: placeholders only. Real values live in `.env` (chmod 600), never in git.

# --- Postgres ---
# `postgres` service credentials (docker compose refuses to start without POSTGRES_PASSWORD).
POSTGRES_USER=football
# REQUIRED — set a strong password here.
POSTGRES_PASSWORD=
POSTGRES_DB=football

# `app` service DSN. The host MUST be the compose service name `postgres`; the password must match
# POSTGRES_PASSWORD above. (Kept here rather than assembled in docker-compose.yml so no tracked
# file contains a connection string.)
DATABASE_URL=postgresql+asyncpg://football:<your-password>@postgres:5432/football

# --- Build identity (optional) ---
# Git SHA baked into the app image at build time and shown by GET /ops/status. Compose
# interpolates it from this file, so setting it here is equivalent to:
#   GIT_SHA=$(git rev-parse --short HEAD) docker compose build
# GIT_SHA=

# --- Cloudflare Tunnel (optional; see deploy/cloudflare-tunnel.md) ---
# Paste the token from Zero Trust > Networks > Tunnels > your tunnel > "Install connector".
# Enabling the profile here means a plain `docker compose up -d` also starts cloudflared.
TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel

# --- Ingestion scheduler (runs inside the app process; keep exactly one instance) ---
ENABLE_SCHEDULER=true
SYNC_ODDS_INTERVAL=600
SYNC_SETTLE_INTERVAL=900
HKJC_THROTTLE_SECONDS=1.5
ODDS_RETENTION_DAYS=120
LEAGUE_WHITELIST=EPL,LALIGA,SERIEA,BUNDESLIGA,LIGUE1,UCL

# --- ML prediction engine (sub-system B) ---
ML_ENABLE=true
ML_ARTIFACT_DIR=artifacts/ml
# Align training/eval/serving market priors to the last HKJC snapshot strictly before kickoff - N hours
# (0 = legacy: last snapshot strictly before kickoff; CLV always uses the true closing line).
ML_PRIOR_LEAD_HOURS=48
ML_RETRAIN_INTERVAL=604800
ML_PREDICT_LOOKAHEAD_HOURS=48
ML_MIN_TRAIN_ROWS=500
ML_VALUE_EDGE_THRESHOLD=0.02
ML_CHAMPION_MARGIN=0.0
# HKJC HAD pool overround, measured from our own snapshots (median 1.1327 over 3,838).
# roi_real is what a bettor at HKJC actually gets; roi at 1.0 is vig-free and unattainable.
ML_EXEC_OVERROUND=1.13
# Minimum number of real-price bets before the gate trusts a challenger's roi_real:
# a zero-bet run reports 0.0, which would otherwise pass the ">= 0" bar trivially.
ML_GATE_MIN_REAL_BETS=50
ML_HISTORY_FROM_YEAR=2010

# --- Paper ledger (sub-system C) ---
LEDGER_ENABLE=true
SHADOW_LEDGER_ENABLE=true
LEDGER_UPDATE_INTERVAL=3600
LEDGER_INITIAL_BANKROLL=1000
LEDGER_KELLY_MULTIPLIER=0.5
LEDGER_MAX_STAKE_FRACTION=0.05
LEDGER_MIN_STAKE=10

# --- Deterministic risk agent (paper/audit only) ---
AGENT_MAX_ODDS=5.0

# --- B analyst (StrikerAPI lineups only; never odds) ---
STRIKER_API_KEY=
STRIKER_BASE_URL=https://mcp.strikerapi.com
STRIKER_TIMEOUT_SECONDS=20

# --- C decision agent (OpenAI-compatible, OpenCode Go) ---
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-v4.1-flash
AGENT_LLM_TEMPERATURE=0.0
AGENT_LLM_TIMEOUT_SECONDS=30

# --- Remote endpoints (defaults are fine; only change if HKJC/football-data move) ---
# HKJC_GRAPHQL_URL=https://info.cld.hkjc.com/graphql/base/
# HKJC_REFERER=https://bet.hkjc.com/
# HKJC_ORIGIN=https://bet.hkjc.com
# FOOTBALL_DATA_BASE=https://www.football-data.co.uk
