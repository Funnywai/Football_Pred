# Copy to the repo root as `.env` on the server:  cp deploy/env.example .env
# docker compose reads this file for both container env and ${...} interpolation.

# --- Postgres (consumed by the `postgres` service and DATABASE_URL defaults) ---
POSTGRES_USER=football
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=football

# --- Cloudflare Tunnel (optional; see deploy/cloudflare-tunnel.md) ---
# Paste the token from Zero Trust > Networks > Tunnels > your tunnel > "Install connector".
# Enabling the profile here means a plain `docker compose up -d` also starts cloudflared.
TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel

# --- Ingestion scheduler (runs inside the app process; keep exactly one instance) ---
ENABLE_SCHEDULER=true
SYNC_ODDS_INTERVAL=600
SYNC_SETTLE_INTERVAL=900
HKJC_THROTTLE_SECONDS=1.5
ODDS_RETENTION_DAYS=120
LEAGUE_WHITELIST=EPL,LALIGA,SERIEA,BUNDESLIGA,LIGUE1,UCL

# --- ML prediction engine (sub-system B) ---
ML_ENABLE=true
ML_ARTIFACT_DIR=artifacts/ml
# Align training/eval/serving market priors to the last HKJC snapshot at or before kickoff - N hours
# (0 = legacy: last snapshot strictly before kickoff; CLV always uses the true closing line).
ML_PRIOR_LEAD_HOURS=48
ML_RETRAIN_INTERVAL=604800
ML_PREDICT_LOOKAHEAD_HOURS=48
ML_MIN_TRAIN_ROWS=500
ML_VALUE_EDGE_THRESHOLD=0.02
ML_CHAMPION_MARGIN=0.0
ML_HISTORY_FROM_YEAR=2010

# --- Paper ledger (sub-system C) ---
LEDGER_ENABLE=true
LEDGER_UPDATE_INTERVAL=3600
LEDGER_INITIAL_BANKROLL=1000
LEDGER_KELLY_MULTIPLIER=0.5
LEDGER_MAX_STAKE_FRACTION=0.05
LEDGER_MIN_STAKE=10

# --- Remote endpoints (defaults are fine; only change if HKJC/football-data move) ---
# HKJC_GRAPHQL_URL=https://info.cld.hkjc.com/graphql/base/
# HKJC_REFERER=https://bet.hkjc.com/
# HKJC_ORIGIN=https://bet.hkjc.com
# FOOTBALL_DATA_BASE=https://www.football-data.co.uk
