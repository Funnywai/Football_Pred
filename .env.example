# New-method deployment/development environment. Copy to .env and fill secrets.
POSTGRES_USER=football
POSTGRES_PASSWORD=
POSTGRES_DB=football_pred

FP_DATABASE_URL=postgresql+psycopg://football:<password>@postgres:5432/football_pred
FP_REDIS_URL=redis://redis:6379/0
FP_FOOTBALL_DATA_ORG_API_KEY=
FP_INITIAL_BANKROLL=10000.00
FP_PAPER_COMPETITIONS=EPL,LALIGA,BUNDESLIGA,SERIEA,LIGUE1,UCL
FP_FEE_RATE=0
FP_HTTP_TIMEOUT_SECONDS=20
FP_HKJC_GRAPHQL_URL=https://info.cld.hkjc.com/graphql/base/
FP_HKJC_QUERIES_DIR=packages/adapters/hkjc_queries
FP_HKJC_QUERY_VERSION=captured-2026-11

# Cloudflare Tunnel for fp.funnywai.tech -> web:3000
TUNNEL_TOKEN=
COMPOSE_PROFILES=tunnel
GIT_SHA=new-method


# LLM Ensemble Lab (separate paper lane)
FP_LLM_ENABLED=false
FP_LLM_PROVIDER=openai_compatible
FP_LLM_MODEL=deepseek-v4.1-flash
FP_LLM_BASE_URL=https://opencode.ai/zen/go/v1
FP_LLM_API_KEY=
FP_LLM_TEMPERATURE=0
FP_LLM_MAX_TOKENS=16000
FP_LLM_TIMEOUT_SECONDS=180
FP_LLM_COMPETITIONS=EPL,LALIGA,BUNDESLIGA,SERIEA,LIGUE1,UCL
FP_LLM_SESSION_ID=
FP_NEWS_FEED_URLS=https://feeds.bbci.co.uk/sport/football/rss.xml,https://www.theguardian.com/football/rss,https://www.skysports.com/rss/12040,https://www.espn.com/espn/rss/soccer/news
